{
  "name": "veg",
  "displayName": "Veg",
  "description": "Veg VS Code Extension",
  "publisher": "verdverm",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "virtualWorkspaces": true
  }, 
  "contributes": {
    "keybindings": [
    {
      "command": "veg-chat-webview.focus",
      "key": "ctrl+g",
      "mac": "cmd+g"
    },{
      "command": "veg-chat-webview.focus",
      "key": "ctrl+shift+g",
      "mac": "cmd+shift+g"
    },{
      "command": "veg-chat-webview.focus",
      "key": "alt+g g",
      "mac": "alt+g g"
    },{
      "command": "veg-sessions.focus",
      "key": "alt+g s",
      "mac": "alt+g s"
    },{
      "command": "veg-agents.focus",
      "key": "alt+g a",
      "mac": "alt+g a"
    },{
      "command": "veg-planning.focus",
      "key": "alt+g p",
      "mac": "alt+g p"
    },{
      "command": "veg-debug-webview.focus",
      "key": "alt+g d",
      "mac": "alt+g d"
    }],
    "commands": [
      {
        "command": "veg.connect",
        "category": "Veg Connect",
        "title": "Veg Connect"
      },
      {
        "command": "veg.explorer.toggleShown",
        "category": "Veg",
        "title": "Toggle Shown (Veg)",
        "icon": "$(filter)"
      },
      {
        "command": "veg.session.showSessionDiff",
        "category": "Veg",
        "title": "Show Session Diff (Veg)",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "veg.session.showFileDiff",
        "category": "Veg",
        "title": "Show File Diff (Veg)",
        "icon": "$(diff-multiple)"
      },
      {
				"command": "veg.sessions.refresh",
        "category": "Veg",
				"title": "veg.sessions.refresh",
        "icon": "$(refresh)"
			},
      {
        "command": "veg.sessions.chat",
        "category": "Veg",
        "title": "veg.sessions.chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "veg.sessions.create",
        "category": "Veggie",
        "title": "Fresh Veggie",
        "icon": "$(add)"
      },
			{
				"command": "veg.sessions.edit",
        "category": "Veg",
				"title": "veg.sessions.edit",
        "icon": "$(pencil)"
			},
			{
				"command": "veg.sessions.delete",
        "category": "Veg",
				"title": "veg.sessions.delete",
        "icon": "$(trash)"
			},

      {
				"command": "veg.planning.refresh",
        "category": "Veg Planning",
				"title": "veg.planning.refresh",
        "icon": "$(refresh)"
			},
      {
        "command": "veg.planning.create",
        "category": "Veg Planning",
        "title": "veg.planning.create",
        "icon": "$(add)"
      },
      {
        "command": "veg.planning.createSub",
        "category": "Veg Planning",
        "title": "veg.planning.createSub",
        "icon": "$(add)"
      },
			{
				"command": "veg.planning.status",
        "category": "Veg Planning",
				"title": "veg.planning.status",
        "icon": "$(open-preview)"
			},
			{
				"command": "veg.planning.edit",
        "category": "Veg Planning",
				"title": "veg.planning.edit",
        "icon": "$(pencil)"
			},
			{
				"command": "veg.planning.delete",
        "category": "Veg Planning",
				"title": "veg.planning.delete",
        "icon": "$(trash)"
			},

      {
        "command": "veg.debug.requestSync",
        "category": "Veg Debug",
        "title": "veg.debug.requestSync",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "veg.explorer.toggleShown",
          "group": "navigation"
        },
        {
          "command": "veg.session.showFileDiff",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "veg.explorer.toggleShown",
          "group": "navigation"
        },
        {
          "command": "veg.session.showSessionDiff",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "veg.sessions.create",
          "group": "navigation",
          "when": "view == veg-chat-webview"
        },
        {
          "command": "veg.debug.requestSync",
          "group": "navigation",
          "when": "view == veg-config-webview"
        },
        {
          "command": "veg.debug.requestSync",
          "group": "navigation",
          "when": "view == veg-config-webview"
        },
        {
          "command": "veg.debug.requestSync",
          "group": "navigation",
          "when": "view == veg-debug-webview"
        },
        {
          "command": "veg.debug.requestSync",
          "group": "navigation",
          "when": "view == veg-planning"
        },
				{
					"command": "veg.planning.create",
					"group": "navigation",
					"when": "view == veg-planning"
        },
        {
          "command": "veg.debug.requestSync",
          "group": "navigation",
          "when": "view == veg-sessions"
        },
				{
					"command": "veg.sessions.create",
					"group": "navigation",
					"when": "view == veg-sessions"
				}
      ],
			"view/item/context": [
				{
					"command": "veg.planning.delete",
					"when": "view == veg-planning && viewItem == task",
					"group": "inline"
				},
				{
					"command": "veg.planning.status",
					"when": "view == veg-planning && viewItem == task",
					"group": "inline"
				},
				{
					"command": "veg.planning.createSub",
					"when": "view == veg-planning && viewItem == task",
					"group": "inline"
				},
				{
					"command": "veg.planning.edit",
					"when": "view == veg-planning && viewItem == task",
					"group": "inline"
				},

				{
					"command": "veg.sessions.chat",
					"when": "view == veg-sessions && viewItem == session",
					"group": "inline"
				},
				{
					"command": "veg.sessions.edit",
					"when": "view == veg-sessions && viewItem == session",
					"group": "inline"
				},
				{
					"command": "veg.sessions.delete",
					"when": "view == veg-sessions && viewItem == session",
					"group": "inline"
				}
			]
    },
    "viewsContainers": {
      "activitybar": [{
        "id": "veg-chat-sidebar",
        "title": "Veggie",
        "icon": "media/carrot.svg"
      }],
      "panel": [{
        "id": "veg-manage-panel",
        "title": "VegOut",
        "icon": "media/carrot.svg"
      }]
    },
    "views": {
      "veg-chat-sidebar": [{
        "id": "veg-chat-webview",
        "name": "Veggie",
        "type": "webview",
        "contextualTitle": "Chat"
      }],
      "veg-manage-panel": [{
        "id": "veg-sessions",
        "name": "Sessions",
        "contextualTitle": "Sessions"
      },{
        "id": "veg-debug-webview",
        "name": "Debug",
        "type": "webview",
        "contextualTitle": "Debug"
      },{
        "id": "veg-planning",
        "name": "Planning",
        "contextualTitle": "Planning"
      },{
        "id": "veg-agents",
        "name": "Agents",
        "contextualTitle": "Agents"
      },{
        "id": "veg-config-webview",
        "name": "Config",
        "type": "webview",
        "contextualTitle": "Config"
      }]
		}
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.106.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "dependencies": {
    "ansi-colors": "^4.1.3",
    "jsonc-parser": "^3.3.1",
    "ws": "^8.18.3"
  }
}
